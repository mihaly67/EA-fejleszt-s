#!/bin/sh
### BEGIN INIT INFO
# Provides:          monitor-keeper
# Required-Start:    $local_fs $remote_fs $network $syslog x11-common
# Required-Stop:     $local_fs $remote_fs $network $syslog
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Keeps the monitor awake after KVM switch or DP hotplug
### END INIT INFO

PATH=/sbin:/usr/sbin:/bin:/usr/bin:/usr/local/bin
DESC="Monitor Keeper Daemon"
NAME=monitor-keeper
DAEMON=/usr/local/bin/wake_monitor.sh
PIDFILE=/var/run/$NAME.pid
USER=Jules

case "$1" in
  start)
        echo -n "Starting $DESC: "
        start-stop-daemon --start --quiet --background --make-pidfile --pidfile $PIDFILE --chuid $USER --exec $DAEMON
        echo "$NAME."
        ;;
  stop)
        echo -n "Stopping $DESC: "
        start-stop-daemon --stop --quiet --pidfile $PIDFILE --oknodo
        rm -f $PIDFILE
        echo "$NAME."
        ;;
  restart|force-reload)
        $0 stop
        sleep 1
        $0 start
        ;;
  status)
        if [ -f $PIDFILE ]; then
            PID=$(cat $PIDFILE)
            if kill -0 $PID > /dev/null 2>&1; then
                echo "$NAME is running (PID: $PID)"
                exit 0
            else
                echo "$NAME is not running (PID file exists)"
                exit 1
            fi
        else
            echo "$NAME is not running"
            exit 3
        fi
        ;;
  *)
        echo "Usage: $NAME {start|stop|restart|status}" >&2
        exit 1
        ;;
esac
exit 0
